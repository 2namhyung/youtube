{
  "database": "data/news_radar.db",
  "csv_output": "data/latest_candidates.csv",
  "article_pool_output": "data/latest_article_pool.json",
  "collection_status_output": "data/latest_collection_status.json",
  "collection_delta_output": "data/latest_collection_delta.json",
  "article_pool_limit": 3000,
  "daily_article_limit": 100,
  "excerpt_max_chars": 600,
  "stale_after_hours": 6,
  "lookback_days": 30,
  "minimum_score": 4,
  "acquisition": {
    "primary": "publisher_feeds",
    "semantic_inference_on_collect": false,
    "historical_default_days": 30
  },
  "historical_sources": [
    {
      "name": "한국경제 공식 일별 기사 sitemap",
      "sitemap_url": "https://www.hankyung.com/sitemap/daily-article.xml",
      "allowed_hosts": ["www.hankyung.com"],
      "sitemap_path_prefixes": ["/sitemap/"],
      "article_path_prefixes": ["/article/"],
      "child_date_regex": "/daily-article/(?P<date>[0-9]{8})\\.xml$",
      "child_date_format": "%Y%m%d",
      "provenance": "publisher-sitemap",
      "enabled": true,
      "max_depth": 1,
      "max_sitemaps": 31,
      "max_urls": 600,
      "max_urls_per_sitemap": 10,
      "max_sitemap_bytes": 2000000,
      "max_article_bytes": 750000,
      "concurrency": 8,
      "timeout_seconds": 15,
      "official_discovery": "https://www.hankyung.com/robots.txt"
    },
    {
      "name": "JTBC 공식 일별 기사 sitemap",
      "sitemap_url": "https://news.jtbc.co.kr/sitemaps/articles/2026",
      "sitemap_url_template": "https://news.jtbc.co.kr/sitemaps/articles/{year}",
      "allowed_hosts": ["news.jtbc.co.kr"],
      "sitemap_path_prefixes": ["/sitemaps/articles/"],
      "article_path_prefixes": ["/article/"],
      "child_date_regex": "/articles/(?P<date>[0-9]{4}/[0-9]{4})$",
      "child_date_format": "%Y/%m%d",
      "provenance": "publisher-sitemap",
      "enabled": true,
      "max_depth": 1,
      "max_sitemaps": 32,
      "max_urls": 600,
      "max_urls_per_sitemap": 10,
      "max_sitemap_bytes": 2000000,
      "max_article_bytes": 750000,
      "concurrency": 8,
      "timeout_seconds": 15,
      "official_discovery": "https://news.jtbc.co.kr/robots.txt"
    },
    {
      "name": "나우뉴스 공식 날짜별 전체기사 archive",
      "adapter": "html-daily-archive",
      "archive_url_template": "https://nownews.seoul.co.kr/sitemap/sitemap_index_{date}",
      "allowed_hosts": ["nownews.seoul.co.kr"],
      "sitemap_path_prefixes": ["/sitemap/sitemap_index_"],
      "article_path_prefixes": ["/news/newsView.php"],
      "article_url_regex": "/news/newsView\\.php\\?id=[0-9]+",
      "child_date_regex": "/sitemap_index_(?P<date>[0-9]{8})$",
      "child_date_format": "%Y%m%d",
      "provenance": "publisher-archive",
      "enabled": true,
      "max_depth": 0,
      "max_sitemaps": 30,
      "max_urls": 2000,
      "max_urls_per_sitemap": 50,
      "max_sitemap_bytes": 750000,
      "max_article_bytes": 750000,
      "concurrency": 8,
      "timeout_seconds": 15,
      "official_discovery": "https://nownews.seoul.co.kr/sitemap/sitemap_index.php"
    }
  ],
  "rss_sources": [
    {
      "name": "뉴시스 사회",
