{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-tool-learning-v4-research-official-render-v1",
  "title": "Research-only execution of an exact official example",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "origin", "license", "sourceFiles", "dependencyClosure", "urlAudit", "isolation", "implementations", "result"],
  "properties": {
    "schema": {"const": "motion-tool-learning-v4-research-official-render-v1"},
    "scope": {"const": "research-only"},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "commitUrl"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commitUrl": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/commit/[0-9a-f]{40}$"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "bytes", "reviewStatus"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "reviewStatus": {"const": "approved-for-isolated-research-render"}
      }
    },
    "sourceFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "dependencyClosure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
    "urlAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["scannedFiles", "executionRemoteUrls", "allowlistedReplacements"],
      "properties": {
        "scannedFiles": {"type": "integer", "minimum": 1},
        "executionRemoteUrls": {"type": "array", "maxItems": 0},
        "allowlistedReplacements": {"type": "array", "items": {"$ref": "#/$defs/replacement"}}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "network", "loopbackOnly", "physicalNonSymlink", "containedRealpath", "forbiddenCapabilities", "environmentNames"],
      "properties": {
        "root": {"type": "string", "pattern": "(^|[\\\\/])out[\\\\/]studies[\\\\/]motion-tool-learning-v4-research-"},
        "network": {"const": "blocked"},
        "loopbackOnly": {"type": "boolean"},
        "physicalNonSymlink": {"const": true},
        "containedRealpath": {"const": true},
        "forbiddenCapabilities": {"type": "array", "const": ["secrets", "raw-authority", "provider", "upload", "publication", "production-authority"]},
        "environmentNames": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementations": {
      "type": "object", "additionalProperties": false,
      "required": ["creatorFile", "creatorSha256", "verifierFile", "verifierSha256"],
      "properties": {
        "creatorFile": {"type": "string", "minLength": 1},
        "creatorSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verifierFile": {"type": "string", "minLength": 1},
        "verifierSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "promotionEligible", "productionEligible", "artifact"],
      "properties": {
        "status": {"enum": ["verified-research-render", "blocked"]},
        "promotionEligible": {"const": false},
        "productionEligible": {"const": false},
        "artifact": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "bytes", "physicalNonSymlink", "containedRealpath"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "physicalNonSymlink": {"const": true},
        "containedRealpath": {"const": true}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "bytes", "physicalNonSymlink", "containedRealpath", "name", "version", "license"],
      "properties": {
        "file": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1},
        "physicalNonSymlink": {"const": true}, "containedRealpath": {"const": true},
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}
      }
    },
    "replacement": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceFile", "originalUrl", "localFile", "originalSha256", "adaptedSha256", "semanticChange"],
      "properties": {
        "sourceFile": {"type": "string"}, "originalUrl": {"type": "string", "pattern": "^https://"}, "localFile": {"type": "string"},
        "originalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "adaptedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semanticChange": {"const": false}
      }
    }
  }
}
