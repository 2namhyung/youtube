# YouTube Data API v3, used only for CC candidate discovery and metadata verification.
YOUTUBE_API_KEY=

# Optional local BGM provider commands. Each command receives:
# --prompt <text> --duration <seconds> --seed <int> --output <path>
STABLE_AUDIO_3_COMMAND=
ACE_STEP_COMMAND=

# Dedicated admin-provisioned production tool bundles. Each root needs a
# .newsroom-tool-bundle.json marker and must be outside this workspace, temp,
# and user profile roots.
NEWSROOM_FFMPEG_BUNDLE_ROOT=
NEWSROOM_PYTHON_BUNDLE_ROOT=
# Provision with: npm run newsroom:provision-tool-bundles -- --ffmpeg-source-root <source> --python-source-root <source> --target-base <dedicated-outside-profile-root>
# Python bundles are copied in full; authority invokes the mirrored runtime with -I -S and packages must be present in that copied tree.
# Wan generator and independent signed semantic-QA authority (absolute paths)
NEWSROOM_WAN_BUNDLE_ROOT=
NEWSROOM_WAN_PROVIDER_ID=
NEWSROOM_WAN_PROVIDER_VERSION=
NEWSROOM_WAN_SEMANTIC_QA_BUNDLE_ROOT=
NEWSROOM_WAN_SEMANTIC_QA_PROVIDER_ID=
NEWSROOM_WAN_SEMANTIC_QA_PROVIDER_VERSION=
NEWSROOM_WAN_SEMANTIC_QA_PUBLIC_KEY_PATH=
NEWSROOM_WAN_MAX_SCENES=2
# Required for both the structured video designer and monitor-only audits.
# The home is a dedicated admin-provisioned directory with
# .newsroom-codex-home.json; it must not overlap this workspace/profile/temp.
NEWSROOM_CODEX_EXECUTABLE=
NEWSROOM_CODEX_HOME=
NEWSROOM_CODEX_ARGS_JSON=[]
