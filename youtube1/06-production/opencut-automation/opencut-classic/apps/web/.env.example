# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# Newsroom publishing (server-side only; never commit real values)
PUBLISHING_PUBLIC_BASE_URL=http://localhost:3002
PUBLISHING_TOKEN_ENCRYPTION_KEY=
# Optional: read the publishing encryption key from a local file instead.
PUBLISHING_TOKEN_ENCRYPTION_KEY_FILE=
# Keep false unless this UI is protected by authentication on a remote host.
PUBLISHING_ALLOW_REMOTE_MUTATIONS=false

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Preferred for local development: path to the JSON downloaded from Google Cloud.
YOUTUBE_OAUTH_CREDENTIALS_FILE=
YOUTUBE_APP_AUDITED=false

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
