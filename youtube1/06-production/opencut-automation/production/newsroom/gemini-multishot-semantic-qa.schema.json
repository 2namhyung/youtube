{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-gemini-multishot-semantic-qa-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "storyId", "batchId", "authorities", "reviewer", "shots", "providerAudio", "production", "verification"],
  "properties": {
    "schema": {"const": "newsroom-gemini-multishot-semantic-qa-v1"},
    "storyId": {"type": "string", "minLength": 1},
    "batchId": {"type": "string", "minLength": 1},
    "authorities": {"type": "object", "required": ["promptBatchArtifactSha256", "promptSha256", "sourceCaptureSha256", "sourceSha256"]},
    "reviewer": {"type": "object", "required": ["kind", "reviewerId", "reviewedAt"]},
    "shots": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["shotId", "cutId", "requestedWindow", "observedWindow", "selectedWindow", "authoredFinalCutDurationSeconds", "semanticMatch", "continuityPass", "visibleChange", "noReversal", "providerEchoUsedAsQaEvidence", "referenceObservation", "frameEvidence"], "properties": {"semanticMatch": {"const": true}, "continuityPass": {"const": true}, "visibleChange": {"const": true}, "noReversal": {"const": true}, "providerEchoUsedAsQaEvidence": {"const": false}, "frameEvidence": {"type": "array", "minItems": 2}}}},
    "providerAudio": {"type": "object", "additionalProperties": false, "required": ["discardRequired", "ownerNarrationOnly", "usedAsSemanticQaEvidence"], "properties": {"discardRequired": {"const": true}, "ownerNarrationOnly": {"const": true}, "usedAsSemanticQaEvidence": {"const": false}}},
    "production": {"$ref": "#/$defs/production"},
    "verification": {"type": "object", "additionalProperties": false, "required": ["passed", "status", "sha256"], "properties": {"passed": {"const": true}, "status": {"const": "semantic-pass-pre-render-only"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "production": {"type": "object", "additionalProperties": false, "required": ["provider", "render", "upload", "publication", "stage07", "continuationAuthorized"], "properties": {"provider": {"const": false}, "render": {"const": false}, "upload": {"const": false}, "publication": {"const": false}, "stage07": {"const": false}, "continuationAuthorized": {"const": false}}}}
}
