      "curatedCorpusSha256": { "const": "7b6a5738cb0d0657356cd451632af1c738561e5400df3b9c79150ccd45bb9205" },
      "generatorPromptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "criticPromptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "initialOutputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "critiqueOutputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
