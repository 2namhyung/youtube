{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-sequence-first-radio-edit-v2",
  "type": "object",
  "required": ["schema", "sequenceAuthority", "semanticUnits", "visualBlocks", "sourceAssets", "cuts", "stories"],
  "properties": {
    "schema": {"const": "newsroom-sequence-first-radio-edit-v2"},
    "sequenceAuthority": {"type": "object", "required": ["source", "authorityRun", "narrationAudioSha256", "semanticCutPlanSha256", "storyAuthorities"]},
    "semanticUnits": {"type": "array"},
    "visualBlocks": {"type": "array", "items": {"type": "object", "required": ["blockId", "phaseId", "visualRole", "semanticUnitIds", "cutIds", "sourceAssetIds", "treatments"]}},
    "sourceAssets": {"type": "array", "items": {"type": "object", "required": ["assetId", "storyId", "providerInputStatus", "editScope", "rightsEvidence", "privacyReview"]}},
    "cuts": {"type": "array"},
    "stories": {"type": "array", "items": {"type": "object", "required": ["storyId", "photoScreenTimeCoverage", "evidenceCompleteness", "unresolvedEvidenceGaps"]}}
  }
}
