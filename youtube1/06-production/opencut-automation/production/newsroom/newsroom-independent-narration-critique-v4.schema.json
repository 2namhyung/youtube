{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-independent-narration-critique-v4",
  "title": "Independent newsroom narration critique v4",
  "description": "critic prompt v5 comparative hook, retention and accept/reject record. Runtime adds the exact deterministic owner-rate five-second opening window.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "rejectionReasons", "initialVerdict", "findings", "revisionApplied", "revisionSummary", "narrativeArchitecture", "hookAudit", "retentionAudit", "initialAuthoritySha256", "finalAuthoritySha256", "timing"],
  "properties": {
    "schema": { "const": "newsroom-independent-narration-critique-v4" },
    "decision": { "enum": ["accept", "reject"] },
    "rejectionReasons": {
      "type": "array", "maxItems": 12,
      "items": { "type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {
        "code": { "enum": ["insufficient-narrative-material", "duration-below-minimum", "duration-above-maximum", "factual-grounding-failure", "legal-qualification-failure", "weak-opening-stake", "low-information-gain", "provenance-narration", "repetition-or-padding", "modality-mismatch", "other-editorial-failure"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 800 }
      } }
    },
    "initialVerdict": { "enum": ["pass", "revise"] },
    "narrativeArchitecture": { "enum": ["cold-open-reconstruction", "linear-escalation", "reveal-led", "explanation-led", "record-contrast", "number-contrast", "hybrid"] },
    "hookAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["firstFiveSecondStatus", "firstFiveSecondFunction", "strongestAvailableClaimRefs", "openingClaimRefs", "alternativeBundles", "strongerVerifiedOpeningAvailable", "resolutionLeak", "resolutionLeakJustified", "deferredHighSalienceClaimRefs", "deferralCreatesQuestionAndPayoff", "editorialIntentSatisfied", "rationale", "openingWindow"],
      "properties": {
        "firstFiveSecondStatus": { "enum": ["pass", "reject"] },
        "firstFiveSecondFunction": { "enum": ["imminent-risk", "role-conflict", "consequence", "evidence-reversal", "record-change", "decision-conflict", "number-anomaly", "unresolved-question", "other-case-specific-stake"] },
        "strongestAvailableClaimRefs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "openingClaimRefs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "alternativeBundles": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["claimRefs", "function", "rationale"], "properties": {
          "claimRefs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "function": { "enum": ["imminent-risk", "role-conflict", "consequence", "evidence-reversal", "record-change", "decision-conflict", "number-anomaly", "unresolved-question", "other-case-specific-stake"] },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 800 }
        } } },
        "strongerVerifiedOpeningAvailable": { "type": "boolean" },
        "resolutionLeak": { "type": "boolean" },
        "resolutionLeakJustified": { "type": "boolean" },
        "deferredHighSalienceClaimRefs": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "deferralCreatesQuestionAndPayoff": { "type": "boolean" },
        "editorialIntentSatisfied": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "openingWindow": { "type": "object", "additionalProperties": false, "required": ["schema", "targetSeconds", "compactCharacterBudget", "compactCharacters", "estimatedSeconds", "text", "textSha256", "authority"], "properties": {
          "schema": { "const": "newsroom-owner-rate-opening-window-v1" }, "targetSeconds": { "const": 5 }, "compactCharacterBudget": { "type": "integer", "minimum": 1 }, "compactCharacters": { "type": "integer", "minimum": 1 }, "estimatedSeconds": { "type": "number", "minimum": 0 }, "text": { "type": "string", "minLength": 1 }, "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "authority": { "const": "deterministic-owner-rate-prefix-critic-semantic-review-required" }
        } }
      }
    },
    "retentionAudit": { "type": "object", "additionalProperties": false, "required": ["ledgerLike", "portableCoda", "coldOpenReconstructionAddsInformation", "informationDeltas", "rationale"], "properties": {
      "ledgerLike": { "type": "boolean" }, "portableCoda": { "type": "boolean" }, "coldOpenReconstructionAddsInformation": { "type": "boolean" },
      "informationDeltas": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["function", "claimRefs", "rationale"], "properties": {
        "function": { "enum": ["action-change", "choice-or-response", "consequence", "causal-context", "contrast", "reinterpretation", "legal-result", "unresolved-state", "number-change", "record-or-decision-change"] },
        "claimRefs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 800 }
      } } },
      "rationale": { "type": "string", "minLength": 1, "maxLength": 1500 }
    } },
    "findings": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object", "additionalProperties": false, "required": ["category", "initialStatus", "finalStatus", "targetAuthority", "detail", "exactQuote"], "properties": {
      "category": { "enum": ["factual-grounding", "legal-qualification", "observer-summary", "repetition", "progression", "interest", "modality-fit", "coda", "advisory-duration"] }, "initialStatus": { "enum": ["pass", "revise"] }, "finalStatus": { "enum": ["pass", "reject"] }, "targetAuthority": { "enum": ["global", "initial", "final"] }, "detail": { "type": "string", "minLength": 1, "maxLength": 1200 }, "exactQuote": { "type": "string", "maxLength": 500 }
    } } },
    "revisionApplied": { "type": "boolean" },
    "revisionSummary": { "type": "string", "maxLength": 2000 },
    "initialAuthoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalAuthoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timing": { "type": "object", "additionalProperties": false, "required": ["initial", "final"], "properties": {
      "initial": { "$ref": "#/$defs/timingEstimate" }, "final": { "$ref": "#/$defs/timingEstimate" }
    } }
  },
  "$defs": {
    "timingEstimate": { "type": "object", "additionalProperties": false, "required": ["schema", "compactCharacters", "observedCompactKoreanCharactersPerSecond", "estimatedSeconds", "targetMinimumSeconds", "targetMaximumSeconds", "withinAdvisoryTarget", "authority"], "properties": {
      "schema": { "const": "newsroom-owner-rate-advisory-estimate-v1" }, "compactCharacters": { "type": "integer", "minimum": 0 }, "observedCompactKoreanCharactersPerSecond": { "type": "number", "exclusiveMinimum": 0 }, "estimatedSeconds": { "type": "number", "minimum": 0 }, "targetMinimumSeconds": { "type": "number", "minimum": 0 }, "targetMaximumSeconds": { "type": "number", "minimum": 0 }, "withinAdvisoryTarget": { "type": "boolean" }, "authority": { "const": "advisory-only-owner-narration-locked-timing-remains-required" }
    } }
  }
}
