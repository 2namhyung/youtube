{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-script-admission-rejection-v3",
  "title": "Newsroom script admission rejection v3",
  "description": "Non-authoritative envelope for a v16 generator authority rejected by its read-only critic or deterministic gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "reasons", "packageSha256", "generationSha256", "critiqueSha256", "attemptedAuthoritySha256", "timing"],
  "properties": {
    "schema": { "const": "newsroom-script-admission-rejection-v3" },
    "decision": { "const": "reject" },
    "reasons": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {
      "code": { "enum": ["insufficient-narrative-material", "duration-below-minimum", "duration-above-maximum", "factual-grounding-failure", "legal-qualification-failure", "weak-opening-stake", "low-information-gain", "provenance-narration", "repetition-or-padding", "modality-mismatch", "other-editorial-failure"] },
      "detail": { "type": "string", "minLength": 1, "maxLength": 800 }
    } } },
    "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "critiqueSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attemptedAuthoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timing": { "$ref": "newsroom-independent-narration-critique-v5.schema.json#/properties/timing" }
  }
}
