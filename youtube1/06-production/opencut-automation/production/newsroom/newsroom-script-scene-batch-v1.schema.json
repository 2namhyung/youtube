{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-script-scene-batch-v1",
  "title": "Newsroom approved script scene prompt batch v1",
  "description": "Separate scene prompt response bound to an approved script and narration hash. Scene durations are intent only; semantic cut sealing and owner timing remain downstream authorities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scriptSha256", "narrationSha256", "totalEstimatedDurationSeconds", "cuts"],
  "properties": {
    "schema": { "const": "newsroom-script-scene-batch-v1" },
    "scriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "narrationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "totalEstimatedDurationSeconds": { "type": "number", "minimum": 1, "maximum": 200 },
    "cuts": { "type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["cutId", "sentenceRefs", "narrationText", "semanticClass", "cameraActionKorean", "videoPromptEnglish", "risks", "estimatedDurationSeconds"],
      "properties": {
        "cutId": { "type": "string", "pattern": "^cut-[0-9]{3}$" },
        "sentenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "integer", "minimum": 1, "maximum": 64 } },
        "narrationText": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "semanticClass": { "enum": ["human-action", "information-motion"] },
        "cameraActionKorean": { "type": "string", "minLength": 1, "maxLength": 800 },
        "videoPromptEnglish": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "risks": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
        "estimatedDurationSeconds": { "type": "number", "minimum": 2, "maximum": 3 }
      }
    } }
  }
}
