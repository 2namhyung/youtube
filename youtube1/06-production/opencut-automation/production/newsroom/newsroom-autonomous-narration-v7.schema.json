{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-autonomous-narration-v7",
  "title": "Newsroom autonomous narration and provisional cut plan authority v7",
  "description": "Narration with exact sentence lineage and a closed, advisory, complete provisional cut plan. Owner timing and semantic cut sealing remain required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "narration", "sentences", "provisionalCutPlan", "evidenceLineage"],
  "properties": {
    "schema": { "const": "newsroom-autonomous-narration-v7" },
    "narration": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "sentences": { "type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["text", "claimRefs"], "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "claimRefs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    } },
    "provisionalCutPlan": { "type": "object", "additionalProperties": false, "required": ["schema", "status", "narrationSha256", "cuts"], "properties": {
      "schema": { "const": "newsroom-stage03-provisional-cut-plan-v1" },
      "status": { "const": "advisory-only-owner-timing-and-semantic-cut-seal-required" },
      "narrationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "cuts": { "type": "array", "minItems": 1, "maxItems": 64, "items": {
        "type": "object", "additionalProperties": false, "required": ["cutId", "sentenceRefs", "narrationText", "semanticClass", "cameraActionKorean", "videoPromptEnglish", "risks", "estimatedDurationSeconds"], "properties": {
          "cutId": { "type": "string", "pattern": "^cut-[0-9]{3}$" },
          "sentenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "integer", "minimum": 1, "maximum": 64 } },
          "narrationText": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "semanticClass": { "enum": ["human-action", "information-motion"] },
          "cameraActionKorean": { "type": "string", "minLength": 1, "maxLength": 800 },
          "videoPromptEnglish": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "risks": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
          "estimatedDurationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
        }
      } }
    } },
    "evidenceLineage": { "type": "object", "additionalProperties": false, "required": ["schema", "packageSha256", "eventDossierSha256", "legalReportSha256", "caseBriefSha256", "usedClaimRefs"], "properties": {
      "schema": { "const": "newsroom-autonomous-narration-evidence-lineage-v7" },
      "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "eventDossierSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "legalReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "caseBriefSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "usedClaimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
    } }
  }
}
