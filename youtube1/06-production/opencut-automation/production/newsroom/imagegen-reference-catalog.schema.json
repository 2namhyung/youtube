{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-imagegen-reference-catalog-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "storyId", "authorities", "policy", "assets", "production", "approval"],
  "properties": {
    "schema": {"const": "newsroom-imagegen-reference-catalog-v1"},
    "storyId": {"type": "string", "minLength": 1},
    "authorities": {"type": "object", "additionalProperties": false, "required": ["fullVisualStorylineSha256"], "properties": {"fullVisualStorylineSha256": {"$ref": "#/$defs/sha256"}}},
    "policy": {
      "type": "object",
      "required": ["authorityRole", "factAuthority", "identityAuthority", "qaAuthority", "providerEchoAuthority"],
      "properties": {
        "authorityRole": {"const": "non-authoritative-reference-only"},
        "factAuthority": {"const": false},
        "identityAuthority": {"const": false},
        "qaAuthority": {"const": false},
        "providerEchoAuthority": {"const": false}
      }
    },
    "assets": {"type": "array", "maxItems": 80, "items": {"type": "object", "additionalProperties": false, "required": ["assetId", "role", "file", "generation", "allowedInfluenceScopes", "providerInputStatus", "authorityRole"], "properties": {"assetId": {"type": "string"}, "role": {"enum": ["storyboard-reference", "character-reference", "location-reference", "prop-reference", "creature-reference", "style-reference", "entry-frame-reference"]}, "providerInputStatus": {"const": "deferred-reference-only"}, "authorityRole": {"const": "non-authoritative-reference-only"}, "allowedInfluenceScopes": {"type": "array", "minItems": 1, "maxItems": 1}, "file": {"$ref": "#/$defs/file"}, "generation": {"type": "object", "additionalProperties": false, "required": ["model", "prompt", "promptBytes", "promptSha256"], "properties": {"model": {"const": "imagegen"}, "prompt": {"type": "string", "minLength": 1}, "promptBytes": {"type": "integer", "minimum": 1}, "promptSha256": {"$ref": "#/$defs/sha256"}}}}}},
    "production": {"$ref": "#/$defs/production"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approved", "status", "sha256"], "properties": {"approved": {"const": true}, "status": {"const": "admitted"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "file": {"type": "object", "additionalProperties": false, "required": ["relativePath", "realpath", "bytes", "sha256", "width", "height", "mimeType", "preserved"], "properties": {"relativePath": {"type": "string"}, "realpath": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "mimeType": {"enum": ["image/png", "image/jpeg"]}, "preserved": {"const": true}}}, "production": {"type": "object", "additionalProperties": false, "required": ["provider", "render", "upload", "publication", "stage07", "continuationAuthorized"], "properties": {"provider": {"const": false}, "render": {"const": false}, "upload": {"const": false}, "publication": {"const": false}, "stage07": {"const": false}, "continuationAuthorized": {"const": false}}}}
}
