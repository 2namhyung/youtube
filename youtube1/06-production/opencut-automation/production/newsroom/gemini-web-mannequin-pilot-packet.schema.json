{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-gemini-web-mannequin-pilot-packet-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "storyId", "pilotId", "status", "authorization", "upstream", "surfaceObservation", "references", "shots", "prompt", "operatorInstructions", "production", "integrity"],
  "properties": {
    "schema": {"const": "newsroom-gemini-web-mannequin-pilot-packet-v1"},
    "storyId": {"type": "string", "minLength": 1},
    "pilotId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "status": {"enum": ["operator-ready-duration-unverified", "operator-ready-duration-observed"]},
    "authorization": {"type": "object"},
    "upstream": {"type": "object"},
    "surfaceObservation": {"type": "object"},
    "references": {"type": "array", "minItems": 1, "maxItems": 5},
    "shots": {"type": "array", "minItems": 1, "maxItems": 3},
    "prompt": {"type": "object"},
    "operatorInstructions": {"type": "object"},
    "production": {"type": "object"},
    "integrity": {"type": "object"}
  }
}
