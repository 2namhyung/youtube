{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial-brief.schema.json",
  "title": "Locked newsroom editorial brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ordinaryContext",
    "centralAbsurdity",
    "primaryEmotion",
    "editorialThesis",
    "turningPoint",
    "victimOrPublicStake",
    "systemGap",
    "audienceQuestion",
    "mustIncludeClaimIds",
    "supportingClaimIds",
    "omitClaimIds"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "ordinaryContext": { "type": "string", "minLength": 4, "maxLength": 100 },
    "centralAbsurdity": { "type": "string", "minLength": 12, "maxLength": 180 },
    "primaryEmotion": { "type": "string", "enum": ["황당", "답답", "무서움"] },
    "editorialThesis": { "type": "string", "minLength": 12, "maxLength": 180 },
    "turningPoint": { "type": "string", "minLength": 8, "maxLength": 180 },
    "victimOrPublicStake": { "type": "string", "minLength": 8, "maxLength": 180 },
    "systemGap": { "type": "string", "minLength": 8, "maxLength": 180 },
    "audienceQuestion": { "type": "string", "minLength": 12, "maxLength": 64 },
    "mustIncludeClaimIds": { "type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "supportingClaimIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "omitClaimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
  }
}
