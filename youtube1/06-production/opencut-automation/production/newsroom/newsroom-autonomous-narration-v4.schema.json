{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom-autonomous-narration-v4",
  "title": "Newsroom autonomous narration authority v4",
  "description": "Minimal v16 narration authority: one evidence-fit engine, continuous narration, and exact sentence claim lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "narrativeEngine", "narration", "sentences", "evidenceLineage"],
  "properties": {
    "schema": { "const": "newsroom-autonomous-narration-v4" },
    "narrativeEngine": { "enum": ["suspense", "curiosity-reversal", "role-conflict", "evidence-reversal", "escalating-action", "numeric-contrast"] },
    "narration": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "sentences": { "type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["text", "claimRefs"], "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "claimRefs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    } },
    "evidenceLineage": { "type": "object", "additionalProperties": false, "required": ["schema", "packageSha256", "eventDossierSha256", "legalReportSha256", "usedClaimRefs"], "properties": {
      "schema": { "const": "newsroom-autonomous-narration-evidence-lineage-v4" },
      "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "eventDossierSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "legalReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "usedClaimRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
    } }
  }
}
