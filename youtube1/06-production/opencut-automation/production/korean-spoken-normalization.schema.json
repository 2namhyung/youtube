{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "korean-spoken-normalization-v1",
  "type": "object",
  "required": ["schema", "mode", "spokenOnlyOverride", "inputDraftSha256", "outputDraftSha256", "applications", "creator"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "korean-spoken-normalization-v1" },
    "mode": { "const": "authoritative-script-and-caption-rewrite" },
    "spokenOnlyOverride": { "const": false },
    "inputDraftSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outputDraftSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "creator": { "const": "scripts/apply-korean-spoken-normalization.mjs" },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ruleId", "source", "target", "requiredContext", "equivalence", "sourceIndex"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "sourceSuffix": { "type": "string" },
          "targetSuffix": { "type": "string" },
          "requiredContext": { "type": "string", "minLength": 1 },
          "equivalence": { "type": "string", "minLength": 1 },
          "sourceIndex": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
