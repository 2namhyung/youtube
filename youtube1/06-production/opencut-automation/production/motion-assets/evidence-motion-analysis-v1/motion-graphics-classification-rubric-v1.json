{
  "schema_id": "motion-graphics-classification-rubric-v1",
  "created_at": "2026-08-12T00:00:00+09:00",
  "operational_definition": "A designed graphic system changes over time to communicate meaning, information, hierarchy, continuity, or emotion.",
  "classification_questions": [
    {"id": "q1", "question": "Is there a deliberately designed graphic layer or designed multi-layer composition?", "required_for_motion_graphics": true},
    {"id": "q2", "question": "Does a visible property, content state, relationship, mask, path, or transformation lineage change over time?", "required_for_motion_graphics": true},
    {"id": "q3", "question": "Can the change be attributed to the graphic layer rather than only to footage, editing, or camera movement?", "required_for_motion_graphics": true},
    {"id": "q4", "question": "What communication function does the motion perform?", "allowed_answers": ["explain", "compare", "emphasize", "orient", "connect", "transition", "express", "decorate"]},
    {"id": "q5", "question": "Is the motion relevant to an authorized claim or narrative beat?", "separate_from_classification": true},
    {"id": "q6", "question": "Is the motion well designed?", "separate_from_classification": true}
  ],
  "quality_dimensions": [
    "message clarity",
    "visual hierarchy",
    "composition",
    "semantic consistency",
    "spatial continuity",
    "sequence and stagger",
    "timing",
    "easing",
    "readability",
    "restraint",
    "audio synchronization"
  ],
  "analysis_record_required_fields": [
    "exact_start_seconds",
    "exact_end_seconds",
    "designed_layers",
    "start_state",
    "intermediate_states",
    "end_state",
    "changed_properties",
    "communication_function",
    "non_motion_layers",
    "classification",
    "quality_score",
    "case_fit_score",
    "independent_rebuild_description",
    "confidence"
  ],
  "allowed_classifications": [
    "motion_graphics",
    "mixed_video_with_motion_graphics",
    "static_graphic",
    "video_editing",
    "photo_animation",
    "character_animation",
    "3d_animation_or_reconstruction",
    "vfx_or_compositing",
    "camera_motion_only",
    "insufficient_evidence"
  ],
  "admission_policy": {
    "contact_sheet_only": "candidate_only",
    "continuous_playback_required": true,
    "user_review_required_before_reference_authority": true,
    "classification_quality_and_relevance_must_be_separate": true
  }
}

