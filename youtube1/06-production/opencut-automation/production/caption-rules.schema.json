{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/newsroom-semantic-2line-v3.json",
  "title": "Newsroom semantic two-line caption contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "boundaryEngine",
    "upstreamRepository",
    "upstreamCommit",
    "upstreamLicense",
    "semanticMaxWords",
    "semanticMaxGraphemes",
    "targetGraphemesPerLine",
    "minGraphemesPerCue",
    "maxLines",
    "targetDurationSeconds",
    "minDurationSeconds",
    "maxDurationSeconds",
    "preserveSourceCueBoundaries",
    "preserveWordOrder"
  ],
  "properties": {
    "id": { "const": "newsroom-semantic-2line-v3" },
    "boundaryEngine": { "const": "korean-subtitle-splitter-js-port-v2" },
    "upstreamRepository": { "const": "https://github.com/Leedogin/korean-subtitle-splitter" },
    "upstreamCommit": { "const": "9bc9720eccd9cf5452924f681b12ec85738f9ce8" },
    "upstreamLicense": { "const": "MIT" },
    "semanticMaxWords": { "type": "integer", "minimum": 4, "maximum": 12 },
    "semanticMaxGraphemes": { "type": "integer", "minimum": 23, "maximum": 45 },
    "targetGraphemesPerLine": { "type": "integer", "minimum": 8, "maximum": 24 },
    "minGraphemesPerCue": { "type": "integer", "minimum": 1 },
    "maxLines": { "const": 2 },
    "targetDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "minDurationSeconds": { "type": "number", "minimum": 0.4 },
    "maxDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "preserveSourceCueBoundaries": { "const": true },
    "preserveWordOrder": { "const": true }
  }
}
