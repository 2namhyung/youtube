# Server-side only. Never commit real values.
# YouTube accepts localhost during development. TikTok Web OAuth requires a
# registered static HTTPS callback, so set this to the HTTPS origin that
# reverse-proxies or hosts the newsroom when connecting TikTok.
PUBLISHING_PUBLIC_BASE_URL=http://localhost:3002
PUBLISHING_TOKEN_ENCRYPTION_KEY=
# Keep false unless the remotely hosted newsroom has operator authentication.
PUBLISHING_ALLOW_REMOTE_MUTATIONS=false

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Keep false until Google's API audit permits non-private uploads.
YOUTUBE_APP_AUDITED=false

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Required for Instagram container creation and TikTok PULL_FROM_URL.
# It must be an owned, verified HTTPS origin that serves short-lived signed URLs.
PUBLISHING_MEDIA_BASE_URL=
