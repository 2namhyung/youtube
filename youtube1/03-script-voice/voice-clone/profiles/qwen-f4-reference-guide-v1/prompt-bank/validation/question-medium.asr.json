          "end": 4.42,
          "text": "되나요?"
        }
      ]
    },
    {
      "start": 5.62,
      "end": 8.64,
      "text": "하지만 수사 상황 통지와 피해자 보호는 필요하지 않을까요?",
      "words": [
        {
          "start": 5.62,
