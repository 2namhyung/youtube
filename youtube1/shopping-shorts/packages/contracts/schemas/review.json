          "title": "Surface",
          "type": "string"
        },
        "receipt_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Receipt Ids",
          "type": "array"
        },
        "notes": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "model",
        "surface",
        "receipt_ids",
        "notes"
