    },
    "product": {
      "title": "Product",
      "type": "boolean"
    },
    "visual": {
      "title": "Visual",
      "type": "boolean"
    },
    "audio": {
      "title": "Audio",
      "type": "boolean"
    },
    "captions": {
      "title": "Captions",
      "type": "boolean"
    },
    "attestation": {
      "$ref": "#/$defs/Attestation"
    }
  },
  "required": [
    "subject_id",
    "verdict",
    "facts",
    "product",
    "visual",
    "audio",
